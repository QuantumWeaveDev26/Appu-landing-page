{
  "name": "appu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appu Phase 2 Backend API & Domain Foundation",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:postgres": "node --import tsx --test tests/postgres-integration.test.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "plans:sync": "node dist/db/sync-plans-cli.js",
    "plans:sync:dev": "tsx src/db/sync-plans-cli.ts",
    "subscriptions:reconcile": "node dist/cli/reconcile-subscription.js",
    "subscriptions:reconcile:dev": "tsx src/cli/reconcile-subscription.ts",
    "gateway:smoke": "tsx src/gateway/smoke-test-n8n.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "pg-mem": "^3.0.4",
    "tsx": "^4.19.3"
  }
}
