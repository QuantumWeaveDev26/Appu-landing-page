# ==============================================================================
# Appu Phase 2 Backend Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server Port: Port to bind to (e.g. 3000, 8080). Hostinger/cloud platforms may inject this dynamically.
PORT=3000

# Server Host Address: 0.0.0.0 binds to all network interfaces for hosted container/VM environments.
HOST=0.0.0.0

# Logging Level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
LOG_LEVEL=info

# Allowed CORS Origins: Comma-separated list of approved frontend origins (NO wildcards in production)
# Example: https://appu.yourdomain.com,https://www.appu.yourdomain.com
CORS_ALLOWED_ORIGINS=https://appu.example.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SERVER SECRET)
# ------------------------------------------------------------------------------

# Required PostgreSQL connection string with SSL configuration.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:yourPassword@your-db-host.supabase.com:5432/postgres

# Optional: Dedicated database URL for running real PostgreSQL automated test suite
# TEST_DATABASE_URL=postgresql://postgres:yourPassword@your-db-host.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION (PUBLIC / CLIENT SAFE URL & KEY)
# ------------------------------------------------------------------------------

# Supabase project URL and publishable/anon key used for parent JWT verification
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_yourPublishableKey

# ------------------------------------------------------------------------------
# 4. RAZORPAY SUBSCRIPTIONS & WEBHOOKS (SERVER SECRET)
# ------------------------------------------------------------------------------

# Razorpay API Credentials (TEST Mode: rzp_test_*, LIVE Mode: rzp_live_*)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
# Configure in Razorpay Dashboard -> Webhooks -> Secret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret

# Razorpay Plan ID Mapping (Generic JSON or key-value format for arbitrary active plan codes)
# Approved APPU AI Student Catalogue Mappings (free and signature have no Razorpay plan ID)
# Format: JSON string mapping { "plan_code": "provider_plan_id" } or comma-separated pairs
RAZORPAY_PLAN_MAPPINGS={"evolve_monthly":"plan_TSjT9Ifa8DTh7Z","evolve_annual":"plan_TSjUXWPgXzcgq8","evolve_plus_monthly":"plan_TSjVjSNRMup7HO","evolve_plus_annual":"plan_TSjZ318E9ZXK2O","genesis_monthly":"plan_TSja9QfOGIJzZz","genesis_annual":"plan_TSjbfa4D4Iemuo"}

# ------------------------------------------------------------------------------
# 5. N8N AI SECURE GATEWAY (SERVER SECRET)
# ------------------------------------------------------------------------------

# Upstream webhook endpoint for n8n AI mentor workflow
N8N_APPU_WEBHOOK_URL=https://n8n.your-host.cloud/webhook/your-webhook-id/chat

# Required with N8N_APPU_WEBHOOK_URL in production. Use independent, high-entropy
# secrets for each direction; never expose them to frontend JavaScript or store
# them inside workflow JSON.
N8N_APPU_REQUEST_HMAC_SECRET=replace_with_32_plus_random_characters
N8N_APPU_CALLBACK_HMAC_SECRET=replace_with_a_different_32_plus_character_secret

# Reject signed messages outside this freshness window (30-900 seconds).
N8N_APPU_HMAC_MAX_AGE_SECONDS=300

# Backend transport timeout. A timeout becomes UNKNOWN and retains the usage
# reservation until a signed callback reconciles it. Recommended cutover value:
# 45000 until observed duplicate-workflow tail latency supports reducing it.
N8N_APPU_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# 6. GUEST ACCESS & SESSION SECURITY (SERVER SECRET)
# ------------------------------------------------------------------------------

# Mandatory in production (NODE_ENV=production): High-entropy secret key for
# cryptographically signing unauthenticated guest session tokens (X-Guest-Session-Token)
# with HMAC-SHA256. Minimum 16 characters (recommended: 32+ random characters).
# NEVER expose this secret to frontend JavaScript.
GUEST_SESSION_SECRET=your_secure_random_guest_hmac_secret_min_16_chars

# ------------------------------------------------------------------------------
# 7. IGR LEAD CAPTURE GATEWAY (SERVER SECRET)
# ------------------------------------------------------------------------------

# Upstream webhook endpoint for IGR Academy lead capture workflow
IGR_LEAD_WEBHOOK_URL=
