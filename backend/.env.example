# ==============================================================================
# Appu Phase 2 Backend Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (1-65535)
PORT=3000

# Server Host Address
HOST=0.0.0.0

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=info

# Required PostgreSQL connection URL. Use certificate verification in production.
# Local example: postgresql://postgres:postgres@localhost:5432/appu_db
# Production shape: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appu_db

# Optional: Dedicated test database for real PostgreSQL integration test suite
# Run with: npm run test:postgres
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appu_test_db

# Supabase Auth Configuration
# Used for server-side verification of parent access tokens
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Razorpay Subscriptions (TEST MODE ONLY)
# Used for server-side subscription creation and webhook verification
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret

# Razorpay TEST Mode Plan IDs
# Map each plan code to its corresponding Razorpay dashboard plan ID
# Run 'npm run plans:sync' to persist these into the database
RAZORPAY_PLAN_STARTER_ID=plan_starter_test_id
RAZORPAY_PLAN_GROWTH_ID=plan_growth_test_id
RAZORPAY_PLAN_FAMILY_ID=plan_family_test_id

# n8n Secure AI Gateway Configuration
# Backend gateway proxy URL to live n8n workflow (e.g. chat trigger)
N8N_APPU_WEBHOOK_URL=https://n8n.your-host.cloud/webhook/your-webhook-id/chat
